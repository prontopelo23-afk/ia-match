# Copier ce fichier vers backend/.env puis remplacer les placeholders.
# Ne jamais commiter ni zipper backend/.env.

# Local ou production MongoDB Atlas.
# Local : mongodb://localhost:27017
# Production Render/Atlas : mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ia_match?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
DB_NAME=ia_match

# Optionnel : appels LLM réels. Créer de nouvelles clés côté fournisseur.
EMERGENT_LLM_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_SITE_URL=http://localhost:8081
OPENROUTER_APP_NAME="IA Match"

# CORS local + bêta publique.
# Remplacer https://ia-match-web.onrender.com par l’URL réelle du frontend public.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://192.168.1.32:8081,https://ia-match-web.onrender.com
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://192.168.1.32:8081,https://ia-match-web.onrender.com

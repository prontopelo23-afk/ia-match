# Local LAN / Expo Go : remplacer par l’IP du Mac.
# EXPO_PUBLIC_BACKEND_URL=http://192.168.1.32:8000

# Bêta publique : remplacer par l’URL HTTPS de l’API Render/Railway/Fly.
EXPO_PUBLIC_BACKEND_URL=https://ia-match-api.onrender.com

# Pour un build web statique de bêta, le resolver normal est plus stable.
EXPO_USE_FAST_RESOLVER=0
METRO_CACHE_ROOT=.metro-cache
